<h1>{{title}}</h1>

<p>
  <a href="/products">← Volver a productos</a>
</p>

<ul>
  {{#each products}}
    <li>
      <strong>{{this.product.title}}</strong> — 
      Cantidad: {{this.quantity}}
      <button
        type="button"
        onclick="removeItem('{{this.product._id}}')"
      >Eliminar</button>
    </li>
  {{/each}}
</ul>

<p>
  <button type="button" onclick="clearCart()">Vaciar carrito</button>
</p>

<script>
  const cartId = "{{cartId}}";
  function removeItem(productId) {
    fetch(`/api/carts/${cartId}/products/${productId}`, {
      method: 'DELETE'
    })
    .then(res => {
      if (!res.ok) throw new Error('Error al eliminar el producto');
      return res.json();
    })
    .then(() => {
      window.location.reload();
    })
    .catch(err => {
      console.error(err);
      alert('❌ ' + err.message);
    });
  }

  function clearCart() {
    if (!confirm('¿Seguro que querés vaciar el carrito?')) return;
    fetch(`/api/carts/${cartId}`, {
      method: 'DELETE'
    })
    .then(res => {
      if (!res.ok) throw new Error('Error al vaciar carrito');
      return res.json();
    })
    .then(() => {
      window.location.reload();
    })
    .catch(err => {
      console.error(err);
      alert('❌ ' + err.message);
    });
  }
</script>
