<div style="max-width: 600px; margin: 50px auto; padding: 30px; text-align: center; font-family: Arial, sans-serif;">
  
  <h1> Prueba para  Autorización por Rol</h1>

  {{#if currentUser}}
    <div style="background-color: #e8f5e9; padding: 20px; border-radius: 8px; border: 2px solid #4caf50; margin-bottom: 30px;">
      <h2 style="margin-top: 0; color: #2e7d32;">✓ Autenticado</h2>
      <p><strong>Nombre:</strong> {{currentUser.first_name}} {{currentUser.last_name}}</p>
      <p><strong>Email:</strong> {{currentUser.email}}</p>
      <p style="margin: 20px 0;">
        <strong>Rol:</strong>
        {{#if (eq currentUser.role "admin")}}
          <span style="display: inline-block; background-color: #ff9800; color: white; padding: 8px 16px; border-radius: 4px; font-weight: bold; font-size: 16px;">👨‍💼 ADMIN</span>
        {{else}}
          <span style="display: inline-block; background-color: #2196f3; color: white; padding: 8px 16px; border-radius: 4px; font-weight: bold; font-size: 16px;">👤 USER</span>
        {{/if}}
      </p>
    </div>

    <div style="text-align: left; background-color: #f5f5f5; padding: 20px; border-radius: 8px;">
      <h3 style="margin-top: 0;">Información del Usuario</h3>
      <pre style="background-color: #fff; padding: 15px; border-radius: 4px; overflow-x: auto; font-size: 12px;">{{userJSON}}</pre>
    </div>

  {{else if error}}
    <div style="background-color: #ffebee; padding: 20px; border-radius: 8px; border: 2px solid #f44336; margin-bottom: 30px;">
      <h2 style="margin-top: 0; color: #c62828;">⚠️ Error</h2>
      <p style="color: #c62828; font-weight: bold;">{{error}}</p>
      <p>Intenta con un token válido.</p>
    </div>

  {{else}}
    <div style="background-color: #ffebee; padding: 20px; border-radius: 8px; border: 2px solid #f44336; margin-bottom: 30px;">
      <h2 style="margin-top: 0; color: #c62828;">⚠️ No Autenticado</h2>
      <p>Inicia sesión para ver tu información de autorización.</p>
      
      <div style="margin-top: 25px; text-align: left;">
        <h3>🔗 Opción 1: Usar URL con token</h3>
        <p>Pega tu token JWT en la URL:</p>
        <div style="background-color: #f0f0f0; padding: 10px; border-radius: 4px; margin: 10px 0; overflow-x: auto;">
          <code style="font-size: 12px;">http://localhost:8080/auth-demo?token=TU_JWT_AQUI</code>
        </div>
        
        <h3>📬 Opción 2: Login y Postman</h3>
        <p>Copia el token del login y envíalo en Postman:</p>
        <div style="background-color: #f0f0f0; padding: 10px; border-radius: 4px; margin: 10px 0;">
          <code style="font-size: 12px;">GET /auth-demo<br>Header: Authorization: Bearer TU_JWT_AQUI</code>
        </div>
      </div>
    </div>
  {{/if}}

</div>

